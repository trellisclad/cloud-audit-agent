# ── Authentication ──────────────────────────────────────────────
# Option 1: Claude Max plan (recommended)
#   No API key needed — the Agent SDK uses your Claude Code CLI session.
#   Just make sure you're signed in: claude auth login
#
# Option 2: Anthropic API key
#   Uncomment and set if you have separate API credits:
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option 3: AWS Bedrock
#   Uncomment to route LLM calls through Bedrock (data stays in AWS):
# CLAUDE_CODE_USE_BEDROCK=1

# ── AWS credentials ────────────────────────────────────────────
# Required for audit tools (IAM, S3, EC2, Cost Explorer, etc.)
AWS_REGION=us-east-1
AWS_PROFILE=default
# Or use explicit credentials:
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...
# AWS_SESSION_TOKEN=...         # only for assumed roles / temporary creds

# ── Observability (optional) ───────────────────────────────────
# Phoenix tracing — defaults to http://localhost:6006
# PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006
